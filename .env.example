NODE_ENV=development
PORT=10000
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOURCLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=piso_tabs_licensing
SESSION_PEPPER=REPLACE_WITH_64_HEX_CHAR_RANDOM_VALUE
LICENSE_PEPPER=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_RANDOM_VALUE
# Render origin e.g. https://piso-tabs-license-portal.onrender.com
APP_ORIGIN=http://localhost:5173
# Only for initial admin bootstrap command, remove these after executing it:
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Generate once with node scripts/create-signing-key.js. Never commit a real private key.
LICENSE_SIGNING_PRIVATE_KEY_B64=
